            "matcher": { "id": "byName", "options": "Approval Rate" },
            "properties": [
              { "id": "unit", "value": "percentunit" },
              { "id": "decimals", "value": 1 },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [
                { "color": "red", "value": null },
                { "color": "yellow", "value": 0.3 },
                { "color": "green", "value": 0.5 }
              ]}}
            ]
          }
        ]
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "ffeagtzfyvvnkf" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*) AS \"Total Calls\", COUNT(DISTINCT model_id) AS \"Models Used\", COUNT(DISTINCT provider) AS \"Providers\", COUNT(CASE WHEN downstream_verdict IN ('approved','approve') THEN 1 END)::float / NULLIF(COUNT(CASE WHEN downstream_verdict IS NOT NULL THEN 1 END), 0) AS \"Approval Rate\", COUNT(CASE WHEN role = 'B1_solver' THEN 1 END) AS \"Solve Attempts\" FROM senate_telemetry WHERE dry_run = false;",
          "refId": "A"
        }
      ]
    }
  ],
